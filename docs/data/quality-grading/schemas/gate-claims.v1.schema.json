{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "data-workspace.gate-claims.v1",
 "title": "Author gate claims (claims to be checked, not evidence)",
 "type": "object",
 "required": [
  "schema",
  "key",
  "content_hash",
  "claims"
 ],
 "properties": {
  "schema": {
   "const": "data-workspace.gate-claims.v1"
  },
  "key": {
   "type": "string",
   "pattern": "^(processes|flows|lifecyclemodels|sources):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}@[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$"
  },
  "content_hash": {
   "type": "string",
   "minLength": 16
  },
  "note": {
   "type": "string"
  },
  "claims": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "gate",
     "result",
     "report_ref",
     "checked_at"
    ],
    "properties": {
     "gate": {
      "enum": [
       "A04",
       "A06",
       "A07"
      ]
     },
     "result": {
      "enum": [
       "pass",
       "fail",
       "not_applicable",
       "not_run"
      ]
     },
     "report_ref": {
      "type": "string",
      "minLength": 1
     },
     "checked_at": {
      "type": "string",
      "minLength": 10
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false
}